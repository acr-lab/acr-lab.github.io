{%- comment -%}
  Renders one seminar talk from _data/seminars.yml.
  Parameters:
    talk     – the talk entry
    collapse – if true, the abstract and speaker bio are folded behind a toggle (used for past talks)
{%- endcomment -%}
{%- assign t = include.talk -%}
<div class="seminar-talk card">
  <div class="card-body">
    <div class="seminar-meta">
      <span class="seminar-date">{{ t.date | date: '%A, %b %-d, %Y' }}</span>
      {%- if t.time and t.time != '' %} · {{ t.time }}{% endif -%}
      {%- if t.location and t.location != '' %} · {{ t.location }}{% endif -%}
      {%- if t.mode and t.mode != '' %}
        <span class="seminar-type seminar-mode"><i class="fa-solid fa-video"></i> {{ t.mode }}</span>
      {%- endif -%}
      {%- if t.type and t.type != '' %}
        <span class="seminar-type">{{ t.type }}</span>
      {%- endif -%}
    </div>
    <div class="seminar-speaker">
      {%- if t.speaker_url and t.speaker_url != '' -%}
        <a href="{{ t.speaker_url }}" target="_blank" rel="noopener noreferrer">{{ t.speaker }}</a>
      {%- else -%}
        {{ t.speaker }}
      {%- endif -%}
      {%- if t.affiliation and t.affiliation != '' %}
        <span class="seminar-affiliation">({{ t.affiliation }})</span>
      {%- endif -%}
    </div>
    <div class="seminar-title">{{ t.title }}</div>
    {%- assign has_abstract = false -%}
    {%- if t.abstract and t.abstract != '' -%}{%- assign has_abstract = true -%}{%- endif -%}
    {%- assign has_bio = false -%}
    {%- if t.bio and t.bio != '' -%}{%- assign has_bio = true -%}{%- endif -%}
    {%- if has_abstract or has_bio -%}
      {%- capture details_body -%}
      {%- if has_abstract -%}{{ t.abstract | markdownify }}{%- endif -%}
      {%- if has_bio -%}
        <div class="seminar-bio">
          <div class="seminar-bio-label">About the speaker</div>
          {{ t.bio | markdownify }}
        </div>
      {%- endif -%}
    {%- endcapture -%}
      {%- if include.collapse %}
        <details class="seminar-abstract">
          <summary>
            {% if has_abstract %}Abstract{% else %}About the speaker{% endif %}
          </summary>
          {{ details_body }}
        </details>
      {%- else %}
        <div class="seminar-abstract">
          {{ details_body }}
        </div>
      {%- endif -%}
    {%- endif -%}
    {%- assign has_paper = false -%}
    {%- if t.paper and t.paper != '' -%}{%- assign has_paper = true -%}{%- endif -%}
    {%- assign has_papers = false -%}
    {%- if t.papers and t.papers.size > 0 -%}{%- assign has_papers = true -%}{%- endif -%}
    {%- assign has_slides = false -%}
    {%- if t.slides and t.slides != '' -%}{%- assign has_slides = true -%}{%- endif -%}
    {%- assign has_video = false -%}
    {%- if t.video and t.video != '' -%}{%- assign has_video = true -%}{%- endif -%}
    {%- assign has_url = false -%}
    {%- if t.url and t.url != '' -%}{%- assign has_url = true -%}{%- endif -%}
    {%- if has_paper or has_papers or has_slides or has_video or has_url %}
      <div class="seminar-links">
        {%- if has_paper -%}
          <a href="{{ t.paper }}" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-file-lines"></i> Paper</a>
        {%- endif -%}
        {%- if has_papers -%}
          {%- for p in t.papers -%}
            <a href="{{ p }}" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-file-lines"></i> Paper [{{ forloop.index }}]</a>
          {%- endfor -%}
        {%- endif -%}
        {%- if has_slides -%}
          <a href="{{ t.slides | relative_url }}" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-file-pdf"></i> Slides</a>
        {%- endif -%}
        {%- if has_video -%}
          <a href="{{ t.video }}" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-video"></i> Video</a>
        {%- endif -%}
        {%- if has_url -%}
          <a href="{{ t.url }}" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-arrow-up-right-from-square"></i> More info</a>
        {%- endif -%}
      </div>
    {%- endif %}
  </div>
</div>
